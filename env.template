# =============================================================================
# Mio - Environment Variables Template
# =============================================================================
# Copy this file to .env.local and fill in the values:
#   cp env.template .env.local
# =============================================================================

# -----------------------------------------------------------------------------
# Database (Supabase PostgreSQL)
# -----------------------------------------------------------------------------
# Connection string for Supabase PostgreSQL
# Use the "Transaction Pooler" connection string for serverless environments
# Format: postgresql://[user]:[password]@[host]:6543/[database]?sslmode=require
DATABASE_URL=

# -----------------------------------------------------------------------------
# Supabase Storage
# -----------------------------------------------------------------------------
# Supabase project URL (found in Project Settings > API)
SUPABASE_URL=

# Supabase service role key (found in Project Settings > API > service_role)
# WARNING: This key has full access to your project, keep it secret!
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Upstash Redis
# -----------------------------------------------------------------------------
# Upstash Redis REST URL (found in Upstash Console)
UPSTASH_REDIS_URL=

# Upstash Redis REST Token (found in Upstash Console)
UPSTASH_REDIS_TOKEN=

# -----------------------------------------------------------------------------
# LLM Providers
# -----------------------------------------------------------------------------
# OpenAI API Key (if using OpenAI)
OPENAI_API_KEY=

# Anthropic API Key (if using Anthropic)
ANTHROPIC_API_KEY=

# LLM Provider to use (openai | anthropic)
LLM_PROVIDER=openai

# -----------------------------------------------------------------------------
# Audio Generation
# -----------------------------------------------------------------------------
# ElevenLabs API Key (for TTS and SFX)
ELEVENLABS_API_KEY=

# Suno API Key (for music generation)
SUNO_API_KEY=

# -----------------------------------------------------------------------------
# API Configuration
# -----------------------------------------------------------------------------
# API Port
API_PORT=3001

# API URL (for frontend to call)
NEXT_PUBLIC_API_URL=http://localhost:3001

# -----------------------------------------------------------------------------
# Frontend Configuration
# -----------------------------------------------------------------------------
# Frontend Port (Next.js default)
WEB_PORT=3000
