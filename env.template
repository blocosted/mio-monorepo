# =============================================================================
# Mio - Environment Variables Template
# =============================================================================
# Copy this file to .env.local and fill in the values:
#   cp env.template .env.local
# =============================================================================

# -----------------------------------------------------------------------------
# Database (Supabase PostgreSQL)
# -----------------------------------------------------------------------------
# Connection string for Supabase PostgreSQL
# Use the "Transaction Pooler" connection string for serverless environments
# Format: postgresql://[user]:[password]@[host]:6543/[database]?sslmode=require
DATABASE_URL=

# -----------------------------------------------------------------------------
# Supabase
# -----------------------------------------------------------------------------
# Supabase project URL (found in Project Settings > API)
SUPABASE_URL=

# Supabase service role key (found in Project Settings > API > service_role)
# WARNING: This key has full access to your project, keep it secret!
# Used by CLI/tools (and can be used by server if needed).
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
# Recommended: single Redis URL.
# - Local: redis://:password@localhost:6379
# - Upstash (TLS): rediss://:password@<host>.upstash.io:6379
REDIS_URL=

# Alternative (mainly for local/docker tests)
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# S3 (Supabase Storage via S3 protocol)
# -----------------------------------------------------------------------------
# Enable "S3 protocol" in Supabase Storage settings, then copy the credentials.
# Endpoint example:
#   https://<project-ref>.supabase.co/storage/v1/s3/storage
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional (AWS-style)
S3_SESSION_TOKEN=

# -----------------------------------------------------------------------------
# LLM Providers
# -----------------------------------------------------------------------------
# OpenAI API Key (if using OpenAI)
OPENAI_API_KEY=

# Anthropic API Key (if using Anthropic)
ANTHROPIC_API_KEY=

# LLM Provider to use (openai | anthropic)
LLM_PROVIDER=openai

# -----------------------------------------------------------------------------
# Audio Generation
# -----------------------------------------------------------------------------
# ElevenLabs API Key (for TTS and SFX)
ELEVENLABS_API_KEY=

# Suno API Key (for music generation)
SUNO_API_KEY=

# -----------------------------------------------------------------------------
# API Configuration
# -----------------------------------------------------------------------------
# API Port
API_PORT=3001

# CORS origin (frontend URL)
CORS_ORIGIN=http://localhost:3000

# API URL (for frontend to call)
NEXT_PUBLIC_API_URL=http://localhost:3001

# -----------------------------------------------------------------------------
# Frontend Configuration
# -----------------------------------------------------------------------------
# Frontend Port (Next.js default)
WEB_PORT=3000
