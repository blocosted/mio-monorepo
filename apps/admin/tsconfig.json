{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "jsx": "preserve",
    "lib": ["dom", "dom.iterable", "ESNext"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@mio/api": ["../../apps/api/src/api.server.ts"],
      "@mio/api/*": ["../../apps/api/src/*"],
      "@mio/db": ["../../packages/db/src/index.ts"],
      "@mio/db/*": ["../../packages/db/src/*"],
      "@mio/helpers": ["../../packages/helpers/index.ts"],
      "@mio/helpers/*": ["../../packages/helpers/*"],
      "@mio/shared": ["../../packages/shared/src/index.ts"],
      "@mio/shared/*": ["../../packages/shared/src/*"],
      "@mio/ui": ["../../packages/shared/src/ui/index.ts"],
      "@mio/ui/*": ["../../packages/shared/src/ui/*"]
    },
    "esModuleInterop": true
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules", ".next"]
}
