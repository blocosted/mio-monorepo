{
  "name": "backoffice",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/backoffice/src",
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "next dev --turbopack -p 3002",
        "cwd": "apps/backoffice"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "next build",
        "cwd": "apps/backoffice"
      },
      "outputs": ["{projectRoot}/.next"]
    },
    "start": {
      "executor": "nx:run-commands",
      "options": {
        "command": "next start -p 3002",
        "cwd": "apps/backoffice"
      },
      "dependsOn": ["build"]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit",
        "cwd": "apps/backoffice"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "biome check apps/backoffice/",
        "cwd": "{workspaceRoot}"
      }
    },
    "lint:fix": {
      "executor": "nx:run-commands",
      "options": {
        "command": "biome check --write apps/backoffice/",
        "cwd": "{workspaceRoot}"
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "biome format --write apps/backoffice/",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
