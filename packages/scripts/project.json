{
    "name": "scripts",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "projectType": "library",
    "sourceRoot": "packages/scripts/src",
    "targets": {
        "s3": {
            "executor": "nx:run-commands",
            "options": {
                "command": "bun run packages/scripts/src/s3/cli.ts",
                "cwd": "."
            }
        },
        "llm": {
            "executor": "nx:run-commands",
            "options": {
                "command": "bun run packages/scripts/src/llm/cli.ts",
                "cwd": "."
            }
        },
        "s3:setup": {
            "executor": "nx:run-commands",
            "options": {
                "command": "bun run packages/scripts/src/s3/cli.ts setup",
                "cwd": "."
            }
        },
        "s3:list": {
            "executor": "nx:run-commands",
            "options": {
                "command": "bun run packages/scripts/src/s3/cli.ts list",
                "cwd": "."
            }
        },
        "lint": {
            "executor": "nx:run-commands",
            "options": {
                "command": "eslint packages/scripts/src/",
                "cwd": "."
            }
        },
        "typecheck": {
            "executor": "nx:run-commands",
            "options": {
                "command": "tsc --noEmit",
                "cwd": "packages/scripts"
            }
        }
    }
}
