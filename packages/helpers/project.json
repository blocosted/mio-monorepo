{
  "name": "helpers",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "packages/helpers",
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
